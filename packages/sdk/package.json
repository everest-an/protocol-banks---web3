{
  "name": "@everestan/protocolbanks-sdk",
  "version": "0.2.1",
  "description": "Protocol Banks SDK — agent execution, payments and invoicing for web applications",
  "homepage": "https://protocolbanks.com/agent-api",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "crypto",
    "payments",
    "web3",
    "USDC",
    "stablecoin",
    "x402",
    "ai-agents",
    "trading",
    "hyperliquid",
    "protocol-banks"
  ],
  "author": "Protocol Banks",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^22"
  }
}
