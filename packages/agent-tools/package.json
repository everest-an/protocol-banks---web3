{
  "name": "@everestan/protocolbanks-agent-tools",
  "version": "0.1.1",
  "description": "Tool definitions for the Protocol Banks Agent API — adapt once to the Vercel AI SDK, LangChain, OpenAI or Anthropic",
  "homepage": "https://protocolbanks.com/agent-api",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ai-agents",
    "tools",
    "function-calling",
    "langchain",
    "vercel-ai-sdk",
    "openai",
    "anthropic",
    "trading",
    "hyperliquid",
    "protocol-banks"
  ],
  "author": "Protocol Banks",
  "license": "GPL-3.0-only",
  "peerDependencies": {
    "@everestan/protocolbanks-sdk": ">=0.2.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^22"
  }
}
